+export const metadata: Metadata = {
+  title: "Search",
+  description: "Search the Vidyasagar catalogue.",
+  robots: { index: false, follow: true },
+};
+
+export default async function SearchPage({ searchParams }: Props) {
+  const params = await searchParams;
+  return (
