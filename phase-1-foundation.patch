+  language: string;
+  isbn13: string | null;
+  publication_date: string | null;
+  page_count: number | null;
+  availability: EditionAvailability;
+  is_primary: boolean;
+  publisher: Pick<Publisher, "id" | "name" | "slug"> | null;
