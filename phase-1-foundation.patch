+.skill-notes { display: grid; gap: 16px; }
+.skill-notes p { margin: 8px 0 0; font-size: 15px; }
+.verification-notice { padding: 12px 14px; border-left: 4px solid var(--tide-text); background: #eef2ee; font-size: 15px; }
+.verification-notice.notice-approval_only { border-left-color: var(--coral); background: #faeee8; }
+.verification-notice.notice-none { border-left-color: #9aa3a0; background: #f0efe8; }
+.review-record { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
+.review-level { color: var(--tide-text); font-size: 12px; font-weight: 700; text-transform: uppercase; }
+.review-approval .review-level { color: #8a4a35; }
+.review-facts { display: grid; grid-template-columns: minmax(110px, 170px) 1fr; gap: 8px 18px; margin: 14px 0 0; font-size: 14px; }
+.review-facts dt { color: var(--muted); }
+.review-facts dd { margin: 0; }
+.buy-list { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
+.edition-list { display: grid; gap: 22px; }
+.share { padding-top: 8px; }
+.share h2 { font-size: 20px; }
+.share-list { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 22px; font-size: 14px; }
+.small.muted { margin: 10px 0 0; }
+
+/* Skills pages */
+.skill-tree { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 36px 32px; }
+.skill-tree-group h2 { margin: 0 0 6px; font-family: var(--serif); font-size: 26px; font-weight: 400; }
+.skill-tree-group p { margin: 0 0 8px; }
+.skill-book-list { display: grid; gap: 40px; }
+.skill-book-list > li { display: grid; grid-template-columns: minmax(180px, 220px) 1fr; gap: 28px; align-items: start; }
+.skill-book-note { padding-top: 6px; }
+.skill-book-relation { margin: 0 0 6px; color: var(--tide-text); font-size: 12px; font-weight: 700; text-transform: uppercase; }
+
+/* Prose pages */
+.prose { max-width: 720px; padding-bottom: 110px; }
+.prose h2 { margin: 44px 0 10px; font-family: var(--serif); font-size: 30px; font-weight: 400; }
+.prose h3 { margin: 0 0 4px; font-size: 17px; }
+.prose p, .prose li { color: #3b4d54; line-height: 1.75; }
+.framework-list { display: grid; gap: 18px; margin-top: 18px; }
+.framework-list p { margin: 0 0 4px; }
+.not-found p { color: var(--muted); }
+
+@media (max-width: 760px) {
+  .tile-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 32px 16px; }
+  .filters { grid-template-columns: 1fr; padding: 16px; }
+  .book-detail { width: min(100% - 40px, 560px); padding-block: 28px 80px; }
+  .book-detail-top { grid-template-columns: 1fr; gap: 28px; margin-top: 28px; }
+  .book-detail-cover { max-width: 260px; }
+  .book-detail-summary .detail-title { font-size: 38px; }
+  .review-facts { grid-template-columns: 1fr; gap: 2px; }
+  .review-facts dt { margin-top: 10px; }
+  .skill-book-list > li { grid-template-columns: 1fr; gap: 12px; }
+  .panel { padding: 20px; }
+  .why-heading { font-size: 34px; }
+  .footer-disclosure { width: min(100% - 40px, 560px); }
+  .pagination { gap: 12px; }
+}
