+import { describe, expect, it } from "vitest";
+import { makeChannel, makeEdition } from "@/lib/catalogue/fixtures";
+import { isAllowedRetailerUrl, purchaseOptionsForBook, purchaseOptionsForEdition } from "@/lib/catalogue/purchase";
+
+describe("external purchase options", () => {
+  it("offers Amazon and Flipkart links with sponsored rel attributes", () => {
+    const edition = makeEdition({
+      channels: [
+        makeChannel({ id: "f", channel: "flipkart", destination_url: "https://www.flipkart.com/example/p/itm" }),
+        makeChannel({ id: "a", channel: "amazon" }),
+      ],
+    });
+    const options = purchaseOptionsForEdition(edition);
+    expect(options.map((o) => o.label)).toEqual(["Buy on Amazon", "Buy on Flipkart"]);
+    for (const option of options) {
+      expect(option.rel).toContain("sponsored");
+      expect(option.rel).toContain("noopener");
+    }
+  });
+
+  it("hides disabled channels", () => {
+    const edition = makeEdition({ channels: [makeChannel({ is_enabled: false })] });
+    expect(purchaseOptionsForEdition(edition)).toEqual([]);
+  });
+
+  it("does not guess URLs: an enabled channel without a URL is not shown", () => {
+    const edition = makeEdition({ channels: [makeChannel({ destination_url: null })] });
+    expect(purchaseOptionsForEdition(edition)).toEqual([]);
+  });
+
+  it("rejects look-alike and non-https destinations", () => {
+    expect(isAllowedRetailerUrl("amazon", "https://www.amazon.in/dp/X")).toBe(true);
+    expect(isAllowedRetailerUrl("amazon", "https://amzn.to/abc")).toBe(true);
+    expect(isAllowedRetailerUrl("amazon", "https://amazon.evil.example/dp/X")).toBe(false);
+    expect(isAllowedRetailerUrl("amazon", "https://notamazon.in/dp/X")).toBe(false);
+    expect(isAllowedRetailerUrl("amazon", "http://www.amazon.in/dp/X")).toBe(false);
+    expect(isAllowedRetailerUrl("amazon", "javascript:alert(1)")).toBe(false);
+    expect(isAllowedRetailerUrl("flipkart", "https://www.amazon.in/dp/X")).toBe(false);
+    expect(isAllowedRetailerUrl("flipkart", "https://dl.flipkart.com/s/abc")).toBe(true);
+  });
+
+  it("never exposes direct or bulk channels before those phases exist", () => {
+    const edition = makeEdition({
+      channels: [
+        makeChannel({ id: "d", channel: "direct", fulfilment: "vidyasagar", destination_url: null }),
+        makeChannel({ id: "b", channel: "bulk_enquiry", fulfilment: "vidyasagar", destination_url: null }),
+      ],
+    });
+    expect(purchaseOptionsForBook([edition])).toEqual([]);
+  });
+});
diff --git a/src/lib/catalogue/purchase.ts b/src/lib/catalogue/purchase.ts
new file mode 100644
index 0000000..c1ae80b
--- /dev/null
+++ b/src/lib/catalogue/purchase.ts
@@ -0,0 +1,66 @@
+import type { Edition, PurchaseChannel, PurchaseChannelRecord } from "@/lib/catalogue/types";
+
+/**
+ * Purchase options for Phase 1: external retailers only.
+ *
+ * Direct checkout (priced, server-calculated) and bulk enquiries arrive with the
+ * commerce and institutional-sales phases. Until then those channels are never
+ * returned, even if a row exists, so the site cannot offer something that
+ * does not work yet.
+ */
+export type ExternalChannel = Extract<PurchaseChannel, "amazon" | "flipkart">;
+
+export interface PurchaseOption {
+  channel: ExternalChannel;
+  label: string;
+  href: string;
+  /** Always sponsored: Vidyasagar may earn a commission on these links. */
+  rel: string;
+  editionId: string;
+}
+
+// Mirrors the destination-URL check constraint in the database.
+const RETAILER_URL: Record<ExternalChannel, RegExp> = {
+  amazon: /^https:\/\/([a-z0-9-]+\.)*(amazon\.(in|com)|amzn\.(to|in)|a\.co)(\/|$)/i,
+  flipkart: /^https:\/\/([a-z0-9-]+\.)*(flipkart\.com|fkrt\.(it|cc))(\/|$)/i,
+};
+
+const LABELS: Record<ExternalChannel, string> = {
+  amazon: "Buy on Amazon",
+  flipkart: "Buy on Flipkart",
+};
+
+const CHANNEL_ORDER: ExternalChannel[] = ["amazon", "flipkart"];
+
+export function isAllowedRetailerUrl(channel: ExternalChannel, url: string | null): url is string {
+  if (!url) return false;
+  return RETAILER_URL[channel].test(url);
+}
+
+function toOption(editionId: string, record: PurchaseChannelRecord): PurchaseOption | null {
+  if (!record.is_enabled) return null;
+  if (record.channel !== "amazon" && record.channel !== "flipkart") return null;
+  if (!isAllowedRetailerUrl(record.channel, record.destination_url)) return null;
+  return {
+    channel: record.channel,
+    label: LABELS[record.channel],
+    href: record.destination_url,
+    rel: "sponsored nofollow noopener noreferrer",
+    editionId,
+  };
+}
+
+export function purchaseOptionsForEdition(edition: Edition): PurchaseOption[] {
+  return edition.channels
+    .map((record) => toOption(edition.id, record))
+    .filter((option): option is PurchaseOption => option !== null)
+    .sort((a, b) => CHANNEL_ORDER.indexOf(a.channel) - CHANNEL_ORDER.indexOf(b.channel));
+}
+
+export function purchaseOptionsForBook(editions: Edition[]): PurchaseOption[] {
+  return editions.flatMap(purchaseOptionsForEdition);
+}
+
+export function hasExternalPurchaseOption(editions: Edition[], channel?: ExternalChannel): boolean {
+  return purchaseOptionsForBook(editions).some((option) => !channel || option.channel === channel);
+}
