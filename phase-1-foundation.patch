+
+/* Book detail */
+.book-detail { width: min(1040px, calc(100% - 64px)); margin-inline: auto; padding-block: 48px 120px; }
+.book-detail-top { display: grid; grid-template-columns: minmax(200px, 320px) 1fr; gap: 56px; margin-top: 44px; align-items: start; }
+.book-detail-cover { aspect-ratio: 3 / 4; overflow: hidden; border-radius: 8px; background: #e4e2d6; box-shadow: 0 24px 40px -28px rgb(23 42 53 / 55%); }
