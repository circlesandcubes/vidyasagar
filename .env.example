# Public Supabase project (read-only catalogue access via row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Parent brand link shown in the footer.
NEXT_PUBLIC_PARENT_BRAND_URL=https://circlesandcubes.com

# Never put secrets in NEXT_PUBLIC_* variables. Everything below is SERVER ONLY.

# Bypasses row-level security. Used only by the error-report intake and rate
# limiter (and, in later phases, payment webhooks and the email outbox).
SUPABASE_SERVICE_ROLE_KEY=

# Random string used to hash client addresses for rate limiting (no IPs stored).
RATE_LIMIT_SALT=

# --- Payments (Razorpay). Leave blank to keep online checkout disabled. ---
# Use TEST keys until you have completed a test purchase end to end.
# The dashboard must have payment auto-capture enabled; orders are marked paid
# only on a captured payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to register: https://<your-domain>/api/webhooks/razorpay
# Events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# --- Email (provider-neutral; Resend adapter included). Blank = emails are
# recorded as "skipped", never reported as sent. ---
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=

# Shared secret for the scheduled maintenance route (/api/cron/maintenance):
# expires unpaid orders and retries failed emails. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
