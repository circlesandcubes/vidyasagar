# Public Supabase project (read-only catalogue access via row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Parent brand link shown in the footer.
NEXT_PUBLIC_PARENT_BRAND_URL=https://circlesandcubes.com

# Never put secrets in NEXT_PUBLIC_* variables. Server-only credentials
# (service-role key, payment gateway, email provider) are added in later phases.
